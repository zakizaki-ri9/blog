---
import controllersData from "@/data/sf6-layout/controllers.json";
import mappingsData from "@/data/sf6-layout/mappings.json";
import type { ControllerPreset } from "@/domain/sf6-layout/types";

const presets = controllersData.presets as ControllerPreset[];
const layoutDataJson = encodeURIComponent(
  JSON.stringify({ presets, mappings: mappingsData }),
);

function presetShortName(preset: ControllerPreset): string {
  if (preset.formFactor === "pad") return "パッド";
  if (preset.formFactor === "stick") return "レバー";
  return "レバーレス";
}

const segBtn =
  "cursor-pointer rounded-md border border-transparent px-2.5 py-1.5 text-[0.85rem] text-[var(--sf6-muted)] hover:text-[var(--sf6-text)] data-[active=true]:bg-[var(--sf6-amber)] data-[active=true]:text-[#12141c] data-[active=true]:font-bold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf6-amber)]";
const iconBtn =
  "cursor-pointer rounded-md border border-[var(--sf6-border)] bg-[var(--sf6-panel)] px-2.5 py-1.5 text-[0.85rem] text-[var(--sf6-text)] hover:border-[var(--sf6-amber)] disabled:cursor-not-allowed disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf6-amber)]";
---

<div
  id="sf6-layout-editor"
  class="sf6-editor mx-auto grid w-full max-w-[1120px] gap-3"
  data-config={layoutDataJson}
>
  <header class="sf6-mobile-bar flex items-center justify-between gap-2 md:hidden">
    <div class="flex gap-1 rounded-lg bg-[var(--sf6-panel)] p-1" role="radiogroup" aria-label="テンプレート選択">
      {presets.map((preset) => (
        <button
          type="button"
          class={segBtn}
          data-preset={preset.modelId}
          data-active={preset === presets[0] ? "true" : "false"}
        >
          {presetShortName(preset)}
        </button>
      ))}
    </div>
    <div class="flex gap-1 rounded-lg bg-[var(--sf6-panel)] p-1" role="radiogroup" aria-label="操作方式">
      <button type="button" class={segBtn} data-scheme-chip="classic" data-active="true">
        Classic
      </button>
      <button type="button" class={segBtn} data-scheme-chip="modern" data-active="false">
        Modern
      </button>
    </div>
  </header>

  <div class="sf6-shell grid gap-3 md:grid-cols-[210px_minmax(0,1fr)]">
    <aside class="sf6-sidebar hidden flex-col gap-4 rounded-xl border border-[var(--sf6-border)] bg-[var(--sf6-panel)] p-3 md:flex">
      <div>
        <p class="m-0 text-[0.7rem] tracking-wide text-[var(--sf6-muted)]">UNOFFICIAL</p>
        <p id="sf6-preset-meta" class="m-0 text-[0.95rem] font-bold text-[var(--sf6-text)]">SF6 配置エディター</p>
      </div>

      <fieldset class="m-0 border-0 p-0" aria-label="テンプレート選択">
        <legend class="mb-1 px-0 text-[0.75rem] text-[var(--sf6-muted)]">コントローラー</legend>
        <div class="flex flex-col gap-1">
          {presets.map((preset) => (
            <button
              type="button"
              class:list={[segBtn, "w-full text-left"]}
              data-preset={preset.modelId}
              data-active={preset === presets[0] ? "true" : "false"}
            >
              {presetShortName(preset)}
            </button>
          ))}
        </div>
        <select id="sf6-preset-select" class="sr-only" aria-hidden="true" tabindex="-1">
          {presets.map((preset) => (
            <option value={preset.modelId}>{preset.displayName}</option>
          ))}
        </select>
      </fieldset>

      <fieldset class="m-0 hidden border-0 p-0 md:block" aria-label="操作方式">
        <legend class="mb-1 px-0 text-[0.75rem] text-[var(--sf6-muted)]">操作方式</legend>
        <div class="flex gap-1 rounded-lg bg-[var(--sf6-bg)] p-1">
          <label class={segBtn} data-scheme-chip="classic" data-active="true">
            <input type="radio" name="sf6-scheme" value="classic" class="sr-only" checked />
            Classic
          </label>
          <label class={segBtn} data-scheme-chip="modern" data-active="false">
            <input type="radio" name="sf6-scheme" value="modern" class="sr-only" />
            Modern
          </label>
        </div>
      </fieldset>

      <div>
        <p class="mb-1 mt-0 text-[0.75rem] text-[var(--sf6-muted)]">整列</p>
        <div class="flex gap-1">
          <button id="sf6-align-x" type="button" class={iconBtn} disabled aria-label="縦揃え">縦</button>
          <button id="sf6-align-y" type="button" class={iconBtn} disabled aria-label="横揃え">横</button>
        </div>
      </div>

      <div>
        <p class="mb-1 mt-0 text-[0.75rem] text-[var(--sf6-muted)]">
          大きさ <span data-sf6-size-value>—</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="text-[0.75rem] text-[var(--sf6-muted)]">小</span>
          <input
            class="sf6-size-slider min-w-0 flex-1"
            data-sf6-size-slider
            type="range"
            min="0"
            max="4"
            step="1"
            value="0"
            disabled
            aria-label="大きさ"
          />
          <span class="text-[0.75rem] text-[var(--sf6-muted)]">大</span>
        </div>
        <div class="sf6-size-ticks" data-sf6-size-ticks></div>
      </div>

      <div class="mt-auto flex flex-col gap-2">
        <div class="flex gap-1">
          <button id="sf6-undo" type="button" class={iconBtn} disabled aria-label="元に戻す">戻す</button>
          <button id="sf6-reset" type="button" class={iconBtn}>リセット</button>
        </div>
        <button
          id="sf6-download"
          type="button"
          class="cursor-pointer rounded-md bg-[var(--sf6-amber)] px-3 py-2 text-[0.9rem] font-bold text-[#12141c] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf6-amber)]"
        >
          画像を保存
        </button>
      </div>

      <a
        id="sf6-reference-link"
        class="text-[0.75rem] text-[var(--sf6-amber)] [&[hidden]]:hidden"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        hidden
      >
        参考にしたコントローラー
      </a>
      <p id="sf6-reference-note" class="m-0 text-[0.7rem] text-[var(--sf6-muted)] [&[hidden]]:hidden" hidden>
        ボタン配置の相対関係を参考にした抽象模式図です。
      </p>
    </aside>

    <div class="sf6-canvas-col grid gap-2">
      <div class="sf6-canvas-wrap overflow-hidden rounded-xl border border-[var(--sf6-border)] bg-[var(--sf6-bg)] p-2">
        <svg
          id="sf6-svg"
          class="block h-auto w-full select-none overflow-visible outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sf6-amber)]"
          viewBox="0 0 800 500"
          role="img"
          aria-label="コントローラー配置プレビュー"
          tabindex="0"
          style="touch-action: none;"
        >
          <rect
            id="sf6-body-outline"
            class="sf6-body-outline"
            x="40"
            y="40"
            width="720"
            height="420"
            rx="24"
          ></rect>
          <path id="sf6-body-path" class="sf6-body-outline"></path>
          <g id="sf6-body-inner"></g>
          <g id="sf6-chrome"></g>
          <g id="sf6-guides"></g>
          <g id="sf6-callouts"></g>
          <g id="sf6-slots"></g>
        </svg>
      </div>
      <div class="sf6-size-mobile rounded-xl border border-[var(--sf6-border)] bg-[var(--sf6-panel)] p-3 md:hidden">
        <p class="mb-1 mt-0 text-[0.75rem] text-[var(--sf6-muted)]">
          大きさ <span data-sf6-size-value>—</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="text-[0.75rem] text-[var(--sf6-muted)]">小</span>
          <input
            class="sf6-size-slider min-w-0 flex-1"
            data-sf6-size-slider
            type="range"
            min="0"
            max="4"
            step="1"
            value="0"
            disabled
            aria-label="大きさ"
          />
          <span class="text-[0.75rem] text-[var(--sf6-muted)]">大</span>
        </div>
        <div class="sf6-size-ticks" data-sf6-size-ticks></div>
      </div>
      <p class="sf6-hint m-0 text-center text-[0.8rem] text-[var(--sf6-muted)]">
        ボタンを選んで大きさを変更。右クリックまたは長押しで割当・活性を変更
      </p>
    </div>
  </div>

  <div
    id="sf6-context-menu"
    class="sf6-context-menu"
    role="menu"
    aria-label="スロット操作"
    hidden
  ></div>

  <div
    id="sf6-live-region"
    class="min-h-[1.2em] text-[0.8rem] text-[var(--sf6-muted)]"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <p class="m-0 text-[0.75rem] leading-normal text-[var(--sf6-muted)]">
    本ツールは非公式（Unofficial）です。カプコンおよび各コントローラーメーカーとは関係ありません。
    表示される図は製品写真ではなく、ボタン配置を示す抽象的な模式図です。
  </p>
</div>

<script>
  /* global document */
  import { mountLayoutEditor } from "@/components/tools/sf6/layout-editor";

  const root = document.getElementById("sf6-layout-editor");
  const config = root?.dataset.config;
  if (root && config) {
    const data = JSON.parse(decodeURIComponent(config));
    mountLayoutEditor(root, data);
  }
</script>

<style>
  .sf6-editor {
    --sf6-bg: #12141c;
    --sf6-panel: #1a1d28;
    --sf6-border: #2a3144;
    --sf6-text: #e8edf7;
    --sf6-muted: #8b98b3;
    --sf6-amber: #e8b84a;
    color: var(--sf6-text);
  }

  .sf6-canvas-wrap {
    background-image: radial-gradient(circle, #2a3144 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .sf6-body-outline {
    fill: #2a3148;
    stroke: #8a9bb8;
    stroke-width: 2;
  }

  .sf6-body-outline[hidden] {
    display: none;
  }

  .sf6-body-inner {
    fill: #161922;
    stroke: #3d4a63;
    stroke-width: 1.5;
  }

  .sf6-context-menu {
    position: fixed;
    z-index: 80;
    min-width: 12.5rem;
    max-height: min(70vh, 24rem);
    overflow-y: auto;
    border: 1px solid var(--sf6-border);
    border-radius: 8px;
    background: var(--sf6-panel);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.45);
    padding: 0.25rem 0;
  }

  .sf6-size-slider {
    accent-color: var(--sf6-amber);
  }

  .sf6-size-ticks {
    display: flex;
    justify-content: space-between;
    padding: 0.15rem 1.6rem 0;
    font-size: 0.7rem;
    color: var(--sf6-muted);
  }

  .sf6-context-menu :global(button[role="menuitem"]) {
    display: block;
    width: 100%;
    cursor: pointer;
    border: 0;
    background: transparent;
    padding: 0.625rem 0.75rem;
    text-align: left;
    font-size: 0.85rem;
    color: var(--sf6-text);
  }

  .sf6-context-menu :global(button[role="menuitem"]:hover),
  .sf6-context-menu :global(button[role="menuitem"]:focus-visible) {
    background: var(--sf6-bg);
    outline: none;
  }

  .sf6-context-menu :global(button[role="menuitem"].sf6-menu-danger) {
    color: #fca5a5;
  }
</style>
