---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
import LayoutEditor from "@/components/tools/sf6/LayoutEditor.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead
      title="SF6 配置ビジュアライザ"
      description="ストリートファイター6 のクラシック/モダン操作配置を抽象模式図上で編集し PNG 出力できるツール"
    />
  </head>
  <body>
    <Header />
    <main class="mx-auto w-[calc(100%-2em)] max-w-[1120px] p-4">
      <h1 class="mb-2">SF6 配置エディター</h1>
      <p class="mb-4 text-text">
        パッド・レバー・レバーレスの抽象模式図上でボタン配置を編集できます。
      </p>
      <LayoutEditor />
    </main>
  </body>
</html>
