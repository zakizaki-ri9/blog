---
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead title="SF6 Tools" description="ストリートファイター6 向けツール一覧" />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 720px;
        margin: 0 auto;
        padding: 1em;
      }
      ul {
        list-style: none;
        padding: 0;
      }
      li + li {
        margin-top: 0.75rem;
      }
      a {
        color: rgb(var(--black));
        text-decoration: none;
      }
      a:hover {
        color: rgb(var(--accent));
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1>SF6 Tools</h1>
      <p>ストリートファイター6 向けのツール一覧です。</p>
      <ul>
        <li><a href="/tools/sf6/layout">配置ビジュアライザ</a></li>
      </ul>
    </main>
  </body>
</html>
